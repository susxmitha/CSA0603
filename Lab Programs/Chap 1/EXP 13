#include <stdio.h>

int main()
{
    int n;

    printf("Enter number of steps: ");
    scanf("%d", &n);

    if (n == 1)
    {
        printf("\nNumber of Ways = 1");
        return 0;
    }

    int first = 1;
    int second = 2;

    if (n == 2)
    {
        printf("\nNumber of Ways = 2");
        return 0;
    }

    int ways;

    for (int i = 3; i <= n; i++)
    {
        ways = first + second;
        first = second;
        second = ways;
    }

    printf("\nNumber of Ways = %d", ways);

    return 0;
}
