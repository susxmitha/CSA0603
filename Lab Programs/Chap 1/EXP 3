#include <stdio.h>

int main()
{
    int n;

    printf("Enter array size: ");
    scanf("%d", &n);

    int nums[n];

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    long long sum = 0;

    for (int i = 0; i < n; i++)
    {
        int unique[n];
        int count = 0;

        for (int j = i; j < n; j++)
        {
            int found = 0;

            for (int k = 0; k < count; k++)
            {
                if (unique[k] == nums[j])
                {
                    found = 1;
                    break;
                }
            }

            if (!found)
            {
                unique[count] = nums[j];
                count++;
            }

            sum += (long long)count * count;
        }
    }

    printf("\nSum = %lld", sum);

    return 0;
}
