#include <stdio.h>

int main()
{
    int n;

    printf("Enter array size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int unique[n];
    int count = 0;

    for (int i = 0; i < n; i++)
    {
        int found = 0;

        for (int j = 0; j < count; j++)
        {
            if (arr[i] == unique[j])
            {
                found = 1;
                break;
            }
        }

        if (!found)
        {
            unique[count] = arr[i];
            count++;
        }
    }

    printf("\nUnique Elements:\n");

    for (int i = 0; i < count; i++)
        printf("%d ", unique[i]);

    return 0;
}
