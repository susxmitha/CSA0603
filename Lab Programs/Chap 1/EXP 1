#include <stdio.h>
#include <string.h>

int isPalindrome(char str[])
{
    int i = 0;
    int j = strlen(str) - 1;

    while (i < j)
    {
        if (str[i] != str[j])
            return 0;
        i++;
        j--;
    }

    return 1;
}

int main()
{
    int n;

    printf("Enter number of words: ");
    scanf("%d", &n);

    char words[n][100];

    printf("Enter the words:\n");

    for (int i = 0; i < n; i++)
        scanf("%99s", words[i]);

    for (int i = 0; i < n; i++)
    {
        if (isPalindrome(words[i]))
        {
            printf("First palindrome: %s\n", words[i]);
            return 0;
        }
    }

    printf("No palindrome found\n");

    return 0;
}
