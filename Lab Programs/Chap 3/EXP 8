#include <stdio.h>

int main()
{
    int n, key;

    printf("Enter array size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Enter search key: ");
    scanf("%d", &key);

    int low = 0;
    int high = n - 1;
    int comparisons = 0;
    int found = -1;

    printf("\nBinary Search Steps:\n");

    while (low <= high)
    {
        int mid = (low + high) / 2;
        comparisons++;

        printf("Low = %d, High = %d, Mid = %d, Value = %d\n",
               low + 1, high + 1, mid + 1, arr[mid]);

        if (arr[mid] == key)
        {
            found = mid;
            break;
        }
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found != -1)
        printf("\nPosition = %d", found + 1);
    else
        printf("\nElement not found");

    printf("\nComparisons = %d", comparisons);

    return 0;
}
