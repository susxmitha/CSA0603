#include <stdio.h>

int main()
{
    int n;

    printf("Enter array size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("\nMinimum = %d", arr[0]);
    printf("\nMaximum = %d", arr[n - 1]);

    return 0;
}
