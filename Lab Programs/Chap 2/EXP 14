#include <stdio.h>

int main()
{
    int n;

    printf("Enter number of items: ");
    scanf("%d", &n);

    int weight[n], value[n];
    int capacity;

    printf("Enter weights:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &weight[i]);

    printf("Enter values:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &value[i]);

    printf("Enter capacity: ");
    scanf("%d", &capacity);

    int maxValue = 0;
    int bestMask = 0;

    for (int mask = 0; mask < (1 << n); mask++)
    {
        int totalWeight = 0;
        int totalValue = 0;

        for (int i = 0; i < n; i++)
        {
            if (mask & (1 << i))
            {
                totalWeight += weight[i];
                totalValue += value[i];
            }
        }

        if (totalWeight <= capacity && totalValue > maxValue)
        {
            maxValue = totalValue;
            bestMask = mask;
        }
    }

    printf("\nOptimal Selection: ");

    for (int i = 0; i < n; i++)
    {
        if (bestMask & (1 << i))
            printf("%d ", i);
    }

    printf("\nTotal Value = %d\n", maxValue);

    return 0;
}
