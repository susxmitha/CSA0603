#include <stdio.h>

struct Point
{
    float x;
    float y;
};

int orientation(struct Point p1, struct Point p2, struct Point p3)
{
    float value = (p2.y - p1.y) * (p3.x - p2.x) -
                  (p2.x - p1.x) * (p3.y - p2.y);

    if (value > 0)
        return 1;
    if (value < 0)
        return -1;
    return 0;
}

int main()
{
    int n;

    printf("Enter number of points: ");
    scanf("%d", &n);

    struct Point p[n];

    printf("Enter the points (x y):\n");

    for (int i = 0; i < n; i++)
        scanf("%f %f", &p[i].x, &p[i].y);

    printf("\nConvex Hull Points:\n");

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            int pos = 0, neg = 0;

            for (int k = 0; k < n; k++)
            {
                if (k == i || k == j)
                    continue;

                int o = orientation(p[i], p[j], p[k]);

                if (o > 0)
                    pos++;
                else if (o < 0)
                    neg++;
            }

            if (pos == 0 || neg == 0)
            {
                printf("(%.1f, %.1f)  (%.1f, %.1f)\n",
                       p[i].x, p[i].y,
                       p[j].x, p[j].y);
            }
        }
    }

    return 0;
}
