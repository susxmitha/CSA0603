#include <stdio.h>
#include <string.h>

int findSubstring(char haystack[], char needle[])
{
    int n = strlen(haystack);
    int m = strlen(needle);

    for (int i = 0; i <= n - m; i++)
    {
        int j;

        for (j = 0; j < m; j++)
        {
            if (haystack[i + j] != needle[j])
                break;
        }

        if (j == m)
            return i;
    }

    return -1;
}

int main()
{
    char haystack[100];
    char needle[100];

    printf("Enter haystack: ");
    scanf("%s", haystack);

    printf("Enter needle: ");
    scanf("%s", needle);

    int index = findSubstring(haystack, needle);

    printf("\nIndex = %d", index);

    return 0;
}
