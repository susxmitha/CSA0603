#include <stdio.h>
#include <math.h>

struct Point
{
    int x;
    int y;
};

int main()
{
    int n;

    printf("Enter number of points: ");
    scanf("%d", &n);

    struct Point p[n];

    printf("Enter the points (x y):\n");

    for (int i = 0; i < n; i++)
        scanf("%d %d", &p[i].x, &p[i].y);

    double minDist = 1e9;
    int a = 0, b = 1;

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            double dx = p[i].x - p[j].x;
            double dy = p[i].y - p[j].y;
            double dist = sqrt(dx * dx + dy * dy);

            if (dist < minDist)
            {
                minDist = dist;
                a = i;
                b = j;
            }
        }
    }

    printf("\nClosest Pair: (%d, %d) and (%d, %d)\n",
           p[a].x, p[a].y, p[b].x, p[b].y);

    printf("Minimum Distance = %.6lf\n", minDist);

    return 0;
}
