#include <stdio.h>

struct Point
{
    int x;
    int y;
};

int orientation(struct Point p1, struct Point p2, struct Point p3)
{
    int value = (p2.y - p1.y) * (p3.x - p2.x) -
                (p2.x - p1.x) * (p3.y - p2.y);

    if (value > 0)
        return 1;
    if (value < 0)
        return -1;
    return 0;
}

int main()
{
    int n;

    printf("Enter number of points: ");
    scanf("%d", &n);

    struct Point p[n];

    printf("Enter the points (x y):\n");

    for (int i = 0; i < n; i++)
        scanf("%d %d", &p[i].x, &p[i].y);

    printf("\nConvex Hull:\n");

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            int left = 0, right = 0;

            for (int k = 0; k < n; k++)
            {
                if (k == i || k == j)
                    continue;

                int side = orientation(p[i], p[j], p[k]);

                if (side > 0)
                    left++;
                else if (side < 0)
                    right++;
            }

            if (left == 0 || right == 0)
                printf("(%d,%d) (%d,%d)\n",
                       p[i].x, p[i].y,
                       p[j].x, p[j].y);
        }
    }

    return 0;
}
