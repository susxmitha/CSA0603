#include <stdio.h>

int findKthMissing(int arr[], int n, int k)
{
    int current = 1;
    int i = 0;

    while (k > 0)
    {
        if (i < n && arr[i] == current)
        {
            i++;
        }
        else
        {
            k--;
            if (k == 0)
                return current;
        }

        current++;
    }

    return current;
}

int main()
{
    int n, k;

    printf("Enter array size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Enter k: ");
    scanf("%d", &k);

    printf("\nKth Missing Number = %d", findKthMissing(arr, n, k));

    return 0;
}
